# ============================================================
# .geminiignore — Reduce Antigravity token usage
# Excludes files/dirs from AI context indexing
# ============================================================

# === DEPENDENCIES (4,800+ files, 62 MB — biggest token sink) ===
vendor/
node_modules/

# === BUILD OUTPUTS & LOCAL EXPORTS ===
dist/
searchconsoleexport/

# === BACKUPS & RESTORE ARCHIVES (15,000+ files, 54M+ tokens) ===
backup/
data_backup_pre_enrichment/
scratch/
tmp/
debug/

# === DATA & JSON CATALOGS (12,000+ files, 28M+ tokens) ===
data/
helmets/
helmets_new/
helmet_images/
specs.json
brands-index.json
test_seed.json
helmets_seed.json
helmetsan-core/seed-data/helmets/

# === SCRAPED / STATIC ENTITY COLLECTIONS ===
accessories/
brands/
catalogs/
comparisons/
currencies/
dealers/
distributors/
geo/
helmet-types/
marketplaces/
motorcycles/
offers/
phases/
pricing/
recommendations/
safety-standards/

# === VCS & TESTING RUNTIMES ===
.git/
.phpunit.cache/
.playwright-mcp/
tests/playwright/test-results/

# === WORDPRESS RUNTIME ARTIFACTS ===
wp-content/uploads/

# === LOGS & DEBUG ARTIFACTS ===
*.log
*.sql
*.sql.gz
*.dump
debug_git.sh
git_debug.log
verify_inheritance_remote.php

# === ARCHIVES ===
*.zip
*.tar.gz

# === ENV & SECRETS ===
.env
.env.*
*.expect
*.json.bak
ash-site-*.json

# === LOCK FILES (huge, not useful for AI context) ===
composer.lock
package-lock.json

# === OTHER IDE CONFIGS ===
.cursor/
.vscode/
.idea/

# === CLOUDFLARE WORKERS (separate concern) ===
cloudflare-workers/

# === LEGAL & SPECIFICATION DUMPS ===
legal/
Helmetsan_Helmet_Detail_Second_Pass_Redesign_Specification.txt
Helmetsan_Complete_Redesign_Context.txt

# === BINARY MEDIA ASSETS (Images / Fonts / Vectors) ===
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.ico
*.svg
*.woff
*.woff2
*.ttf
*.eot

# === LARGE SCRIPTS ===
scripts/create_helmets_seed.php
